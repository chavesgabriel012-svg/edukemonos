{
  "name": "edukemonos",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:rls": "pnpm --filter @edukemonos/db-tests test",
    "sources:verify": "pnpm --filter @edukemonos/ingest verify",
    "ai:diagnose": "pnpm --filter @edukemonos/ai diagnose",
    "ingest": "pnpm --filter @edukemonos/ingest ingest",
    "content": "pnpm --filter @edukemonos/ingest content",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "db:bundle": "bash supabase/bundle.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "supabase": "2.119.0"
  }
}
