# Copy to apps/web/.env.local (web) and/or export in your shell (scripts). Never commit real values.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by ingest scripts, grading side-effects and ai_usage logging. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (interchangeable) ----------------------------------------
# "anthropic" or "openai"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Same key under another name, for Claude Code cloud sessions (they strip ANTHROPIC_API_KEY).
# Only read when ANTHROPIC_API_KEY is empty.
EDUKEMONOS_ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model ids are configuration, not code. Each role accepts a comma-separated FALLBACK CHAIN:
# the first model that answers wins; every failed attempt is logged in ai_usage.
# Founder decision (2026-10-01): Claude Haiku 4.5 tutor, Claude Sonnet 5.5 for generation and verification.
MODEL_TUTOR=claude-haiku-4-5
MODEL_BULK=claude-sonnet-5-5
MODEL_VERIFY=claude-sonnet-5-5
# Optional, OpenAI only (embeddings are behind a flag; RAG uses Postgres full-text search first).
MODEL_EMBED=

# Optional effort per role: low | medium | high | xhigh | max (leave empty for the model default).
AI_EFFORT_BULK=
AI_EFFORT_TUTOR=
AI_EFFORT_VERIFY=

# Anthropic only: "default" enables the server-side refusal fallback (beta), which can route a
# refused request to a different (possibly pricier) model. Off unless decided otherwise.
ANTHROPIC_FALLBACKS=off

# USD per 1M tokens, used for the cost estimate AND the spend fuse. With a fuse set, every model in
# the chains above MUST have a price here or the app refuses to start (a blind fuse is no fuse).
# Anthropic list prices, verified at https://www.claude.com/pricing on 2026-10-01:
AI_PRICES_JSON={"claude-haiku-4-5":{"input":1,"output":5},"claude-sonnet-5-5":{"input":2,"output":10}}

# Spend fuse (Costa Rica calendar day / month). When reached, AI calls stop until the window
# resets. Keep these BELOW the prepaid credit / spending limit set in the provider console.
# Suggested for a US$10 prepaid start: 3 per day, 8 per month.
AI_BUDGET_DAILY_USD=3
AI_BUDGET_MONTHLY_USD=8

# --- Limits and retention -------------------------------------------------
# Tutor transcript retention in days (proposal pending legal review, SPEC §12).
RETENTION_DAYS_CHAT=30
TUTOR_MAX_MESSAGES_PER_SESSION=30
TUTOR_MAX_MESSAGES_PER_DAY=60

# --- Tests ----------------------------------------------------------------
# Superuser connection for RLS tests. Locally: eval "$(supabase/tests/start-local-pg.sh)"
TEST_DATABASE_URL=
