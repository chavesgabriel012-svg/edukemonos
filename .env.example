# Copy to apps/web/.env.local (web) and/or export in your shell (scripts). Never commit real values.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by ingest scripts, grading side-effects and ai_usage logging. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (interchangeable) ----------------------------------------
# "anthropic" or "openai"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model ids are configuration, not code. Check the provider's current docs before setting them.
# Example values for Anthropic as of 2026-10-01 (verify before use):
#   tutor/verify: claude-opus-5-5   bulk (cheaper, offline generation): claude-sonnet-5-5
MODEL_BULK=
MODEL_TUTOR=
MODEL_VERIFY=
# Optional, OpenAI only (embeddings are behind a flag; RAG uses Postgres full-text search first).
MODEL_EMBED=

# Optional effort per role: low | medium | high | xhigh | max (leave empty for the model default).
AI_EFFORT_BULK=
AI_EFFORT_TUTOR=
AI_EFFORT_VERIFY=

# Anthropic only: "default" enables the server-side refusal fallback (beta), "off" disables it.
ANTHROPIC_FALLBACKS=default

# USD per 1M tokens, for the cost estimate in ai_usage / admin panel. Verify against current pricing.
# Example (Anthropic list prices cached 2026-09-25):
# AI_PRICES_JSON={"claude-opus-5-5":{"input":4,"output":20},"claude-sonnet-5-5":{"input":2,"output":10}}
AI_PRICES_JSON=

# --- Limits and retention -------------------------------------------------
# Tutor transcript retention in days (proposal pending legal review, SPEC §12).
RETENTION_DAYS_CHAT=30
TUTOR_MAX_MESSAGES_PER_SESSION=30
TUTOR_MAX_MESSAGES_PER_DAY=60

# --- Tests ----------------------------------------------------------------
# Superuser connection for RLS tests. Locally: eval "$(supabase/tests/start-local-pg.sh)"
TEST_DATABASE_URL=
